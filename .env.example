# Copy to .env and fill in values

TELEGRAM_BOT_TOKEN=
OPENROUTER_API_KEY=

# OpenRouter multimodal model (vision + text)
OPENROUTER_MODEL=google/gemini-2.5-flash

# Host path to your Obsidian vault (used by docker-compose bind mount)
# Quote paths with spaces in docker-compose usage / .env as needed
OBSIDIAN_VAULT_PATH=/path/to/your/obsidian/vault

# Folder inside the vault for notes (shared by TikTok and X; source tags tell them apart)
OBSIDIAN_RELATIVE_DIR=Extracts

# Folder inside the vault for post photos and videos. Empty = "<OBSIDIAN_RELATIVE_DIR>/attachments"
# OBSIDIAN_ATTACHMENTS_DIR=Extracts/attachments

# Per-file ceiling for media copied into the vault; larger files are linked instead
# MAX_ATTACHMENT_MB=100

# X posts are saved verbatim (text + links + media) with no model call.
# Set to true to run them through OpenRouter like TikTok videos instead.
X_USE_LLM=false

# Comma-separated Telegram user IDs allowed to use the bot (e.g. 123456789)
# Leave empty to deny everyone until you set your id from /whoami
ALLOWED_TELEGRAM_USER_IDS=

# Host user/group that owns the Obsidian vault (run: id -u && id -g)
# Without this, Docker writes root-owned files that Obsidian often ignores
PUID=1000
PGID=1000

# Local Whisper model size
WHISPER_MODEL=base

# Optional Netscape cookies.txt for TikTok (mounted at /config/cookies.txt)
# Export while logged into tiktok.com if downloads keep failing challenge pages
# Also used for X videos; text and photos need no cookies
# YTDLP_COOKIES_FILE=/config/cookies.txt

# Optional overrides
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# JOB_TIMEOUT_SECONDS=300

# Kagi: notes always get https://kagi.com/search?q=… (unlimited browser searches).
# Set an API key to also resolve a few items to a direct page URL at extract time.
# Key from https://kagi.com/api/keys — billed separately (~$12/1k; $5 ≈ 416 searches).
# KAGI_API_KEY=
# Max API searches per video (0 disables even with a key)
# KAGI_SEARCH_PER_JOB=3
# KAGI_TIMEOUT_SECONDS=15

# Token cost controls (images dominate the bill)
# FRAME_COUNT=8              max images sent per job (video frames or tweet photos)
# FRAME_MAX_WIDTH=512        frames are downscaled to this width
# FRAME_DEDUPE_DISTANCE=12   higher = more aggressive near-duplicate dropping
# MAX_TRANSCRIPT_CHARS=6000  transcript is truncated before sending
# MAX_DESCRIPTION_CHARS=1000
# MAX_AUDIO_SECONDS=420      cap on audio sent to Whisper
# MAX_OUTPUT_TOKENS=1200     hard cap on model output
# RESULT_CACHE_SIZE=32       repeat links are served from cache (0 disables)
